.claude/settings.local.json

#///////////////////////////
# Cocos 项目扩展目录
# cocos-mcp-server 通过 junction 引用仓库根那份，此处不重复跟踪
#///////////////////////////
CocosMCP/extensions/

#///////////////////////////
# Node / 日志
#///////////////////////////
node_modules/
*.log
npm-debug.log*

#///////////////////////////
# 说明：Cocos Creator 项目内部忽略项
# library temp build profiles 等已由
# CocosMCP/CocosMCP/.gitignore 覆盖
# 此处仅作仓库根级别补充
#///////////////////////////

#///////////////////////////
# Cocos MCP 服务器运行时配置（本机状态，不进 git）
# mcp-server.json 为面板端口设置，tool-manager.json 为工具启用状态
#///////////////////////////
CocosMCP/settings/mcp-server.json
CocosMCP/settings/tool-manager.json
CocosMCP/.creator/
